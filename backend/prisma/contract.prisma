// use prisma-8
// Prisma 8 data contract — PSL authoring.
// Run `npx prisma contract emit` after editing, then `npx prisma db init` to sync.

enum Role {
  PATIENT
  DOCTOR
  FACILITY_STAFF
  AMBULANCE_OPERATOR
  BLOOD_DONOR
  ORGAN_DONOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum VerificationKind {
  DOCTOR
  FACILITY
  AMBULANCE
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FacilityType {
  HOSPITAL
  HEALTH_POST
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MedicalRecordType {
  CONSULTATION
  PRESCRIPTION
  LAB_RESULT
  IMAGING
  VACCINATION
  OTHER
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  role         Role        @default(PATIENT)
  verificationStatus VerificationStatus @default(VERIFIED)
  passwordHash String
  phone        String?
  facility      HealthcareFacility? @relation(fields: [facilityId], references: [id])
  facilityId    String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  auditLogs    AuditLog[]
  patient      Patient?
  doctor       Doctor?
  ambulances   Ambulance[]
  bloodDonor   BloodDonor?
  organDonor   OrganDonor?
  bloodRequests BloodRequest[]
  notifications Notification[]
  feedback      Feedback[]
  verificationRequests VerificationRequest[] @relation("UserVerificationRequests")
  reviewedRequests     VerificationRequest[] @relation("UserReviewedRequests")
  sessions     Session[]

  @@index([role])
  @@index([verificationStatus])
  @@index([facilityId])
}

model Session {
  id                String   @id @default(uuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tokenHash         String   @unique
  role              Role
  userAgent         String?
  ip                String?
  createdAt         TimestamptzString @default(now())
  lastSeenAt        TimestamptzString @default(now())
  idleExpiresAt     TimestamptzString
  absoluteExpiresAt TimestamptzString
  revokedAt         TimestamptzString?
  rotatedFrom       String?

  @@index([userId])
  @@index([absoluteExpiresAt])
}

model VerificationRequest {
  id           String                    @id @default(uuid())
  user         User                      @relation("UserVerificationRequests", fields: [userId], references: [id])
  userId       String
  kind         VerificationKind
  payload      String?
  documentUrls String[]
  status       VerificationRequestStatus @default(PENDING)
  reason       String?
  reviewedBy   User?                     @relation("UserReviewedRequests", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   TimestamptzString?
  createdAt    TimestamptzString         @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([status])
  @@index([userId])
}

model AuditLog {
  id        String      @id @default(uuid())
  action    String
  entity    String?
  entityId  String?
  actor     User?       @relation(fields: [actorId], references: [id])
  actorId   String?
  metadata  String?
  createdAt TimestamptzString @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}

model Patient {
  id             String          @id @default(uuid())
  user           User            @relation(fields: [userId], references: [id])
  userId         String          @unique
  phone          String?
  dateOfBirth    TimestamptzString?
  bloodGroup     String?
  address        String?
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  emergencyRequests EmergencyRequest[]
}

model Doctor {
  id             String             @id @default(uuid())
  user           User               @relation(fields: [userId], references: [id])
  userId         String             @unique
  specialization String?
  licenseNumber  String?            @unique
  bio            String?
  facility       HealthcareFacility? @relation(fields: [facilityId], references: [id])
  facilityId     String?
  createdAt      TimestamptzString  @default(now())
  updatedAt      temporal.updatedAtString()
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  availability   DoctorAvailability[]

  @@index([facilityId])
  @@index([specialization])
}

model DoctorAvailability {
  id          String  @id @default(uuid())
  doctor      Doctor  @relation(fields: [doctorId], references: [id])
  doctorId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  slotMinutes Int     @default(30)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([doctorId, weekday])
}

model HealthcareFacility {
  id             String         @id @default(uuid())
  name           String
  type           FacilityType
  address        String
  phone          String?
  operatingHours String?
  latitude       Float?
  longitude      Float?
  services       String[]
  emergencyAvailable Boolean    @default(false)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
  doctors        Doctor[]
  staff          User[]
  appointments   Appointment[]
  emergencyRequests EmergencyRequest[]
  bloodUnits     BloodUnit[]
  bloodRequests  BloodRequest[]
  feedback      Feedback[]

  @@index([type])
}

model Appointment {
  id         String             @id @default(uuid())
  patient    Patient            @relation(fields: [patientId], references: [id])
  patientId  String
  doctor     Doctor             @relation(fields: [doctorId], references: [id])
  doctorId   String
  facility   HealthcareFacility? @relation(fields: [facilityId], references: [id])
  facilityId String?
  startsAt   TimestamptzString
  status     AppointmentStatus  @default(REQUESTED)
  notes      String?
  createdAt  TimestamptzString  @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([doctorId, startsAt])
  @@index([patientId, startsAt])
}

model MedicalRecord {
  id        String   @id @default(uuid())
  patient   Patient  @relation(fields: [patientId], references: [id])
  patientId String
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
  doctorId  String?
  facility  HealthcareFacility? @relation(fields: [facilityId], references: [id])
  facilityId String?
  recordType MedicalRecordType @default(CONSULTATION)
  diagnosis String?
  treatment String?
  notes     String?
  prescriptions String[]
  attachments   String[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([patientId])
  @@index([facilityId])
}

enum AmbulanceType {
  BASIC
  ADVANCED
  ICU
}

enum AmbulanceStatus {
  AVAILABLE
  ASSIGNED
  EN_ROUTE
  ARRIVED
  TRANSPORTING
  COMPLETED
  OFFLINE
}

enum EmergencyCategory {
  MEDICAL
  ACCIDENT
  INJURY
  PREGNANCY
  BREATHING
  OTHER
}

enum EmergencyPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmergencyStatus {
  PENDING
  MATCHED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  TRANSPORTING
  COMPLETED
  CANCELLED
}

enum TripStatus {
  EN_ROUTE
  ARRIVED
  TRANSPORTING
  COMPLETED
  CANCELLED
}

model Ambulance {
  id                String          @id @default(uuid())
  registrationNumber String         @unique
  type              AmbulanceType
  status            AmbulanceStatus @default(OFFLINE)
  driverName        String?
  driverPhone       String?
  operator          User?           @relation(fields: [operatorId], references: [id])
  operatorId        String?
  latitude          Float?
  longitude         Float?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
  trips             Trip[]

  @@index([status])
  @@index([operatorId])
}

model EmergencyRequest {
  id           String            @id @default(uuid())
  requester    User              @relation(fields: [requesterId], references: [id])
  requesterId  String
  patient      Patient?          @relation(fields: [patientId], references: [id])
  patientId    String?
  destination  HealthcareFacility? @relation(fields: [destinationFacilityId], references: [id])
  destinationFacilityId String?
  destinationAddress String?
  pickupLatitude Float
  pickupLongitude Float
  pickupAccuracy Float?
  pickupObtainedAt TimestamptzString?
  pickupAddress String?
  notes        String?
  cancelReason String?
  category     EmergencyCategory
  priority     EmergencyPriority
  status       EmergencyStatus   @default(PENDING)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  trip         Trip?

  @@index([requesterId])
  @@index([status])
}

model Trip {
  id                String   @id @default(uuid())
  emergencyRequest  EmergencyRequest @relation(fields: [emergencyRequestId], references: [id])
  emergencyRequestId String  @unique
  ambulance         Ambulance @relation(fields: [ambulanceId], references: [id])
  ambulanceId       String
  status           TripStatus @default(EN_ROUTE)
  startedAt        TimestamptzString @default(now())
  arrivedAt         TimestamptzString?
  completedAt      TimestamptzString?
  endedAt          TimestamptzString?
  isSimulation     Boolean @default(false)
  locationUpdates  LocationUpdate[]

  @@index([ambulanceId])
}

model LocationUpdate {
  id         String   @id @default(uuid())
  trip       Trip     @relation(fields: [tripId], references: [id])
  tripId     String
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt TimestamptzString @default(now())

  @@index([tripId, recordedAt])
}

enum BloodRequestStatus {
  PENDING
  FULFILLED
  PARTIALLY_FULFILLED
  CANCELLED
}

enum OrganDonorStatus {
  PLEDGED
  VERIFIED
  INACTIVE
}

model BloodDonor {
  id            String   @id @default(uuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique
  bloodGroup    String
  isAvailable   Boolean  @default(true)
  lastDonationDate TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model BloodUnit {
  id        String   @id @default(uuid())
  facility  HealthcareFacility @relation(fields: [facilityId], references: [id])
  facilityId String
  bloodGroup String
  units     Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([bloodGroup])
  @@index([facilityId])
}

model BloodRequest {
  id        String   @id @default(uuid())
  requester User     @relation(fields: [requesterId], references: [id])
  requesterId String
  facility  HealthcareFacility? @relation(fields: [facilityId], references: [id])
  facilityId String?
  bloodGroup String
  units     Int
  status    BloodRequestStatus @default(PENDING)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([bloodGroup])
  @@index([status])
}

model OrganDonor {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  organs    String[]
  consent   Boolean  @default(false)
  status    OrganDonorStatus @default(PLEDGED)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt TimestamptzString @default(now())

  @@index([userId])
  @@index([read])
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
}

model Feedback {
  id        String   @id @default(uuid())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  facility  HealthcareFacility? @relation(fields: [facilityId], references: [id])
  facilityId String?
  rating    Int
  comment   String?
  status    FeedbackStatus @default(PENDING)
  moderationReason String?
  createdAt TimestamptzString @default(now())

  @@index([facilityId])
  @@index([status])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt temporal.updatedAtString()
}
