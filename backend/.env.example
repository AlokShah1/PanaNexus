# Backend environment for PanaNexus. Copy to .env and fill in values.

# PostgreSQL — Prisma 8. For local development use your local Postgres.
# For Neon (Render deploy): DATABASE_URL = pooled connection (…-pooler.neon.tech),
# DIRECT_URL = unpooled direct connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pananexus"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pananexus"

# Secret used to sign session cookies and password verification. Generate with:
#   openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_to_a_long_random_secret"

# Auto-created on first boot by src/lib/bootstrap.ts (idempotent).
ADMIN_EMAIL="pananexusadmin@gmail.com"
ADMIN_PASSWORD="CHANGE_ME_min_8_chars"

# Optional extras (defaults shown).
# PORT=4000
# FRONTEND_URL=http://localhost:3000
# RATE_LIMIT=5000
# AUTH_RATE_LIMIT=5000
# NODE_ENV=development
# UPLOAD_DIR=uploads

# Private medical report storage.
# development/test default is a local, auth-gated adapter. Production should use
# S3-compatible private storage. See docs/STORAGE.md for bucket setup.
# STORAGE_DRIVER=local            # local | s3
# S3_REGION=ap-south-1
# S3_BUCKET=pananexus-medical-reports
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                    # custom S3 endpoint (e.g., https://s3.filebase.com for Filebase)
# REPORT_MAX_FILE_BYTES=15728640  # 15 MB
# REPORT_URL_TTL_SECONDS=300      # presigned download lifetime (5 min)

# Filebase free tier (S3-compatible):
# STORAGE_DRIVER=s3
# S3_REGION=us-east-1
# S3_BUCKET=pananexus-medical-reports
# S3_ENDPOINT=https://s3.filebase.com
# S3_ACCESS_KEY_ID=<your-filebase-access-key>
# S3_SECRET_ACCESS_KEY=<your-filebase-secret-key>
# REPORT_MAX_FILE_BYTES=15728640  # 15 MB
# REPORT_URL_TTL_SECONDS=300      # presigned download lifetime (5 min)
# Filebase free tier: 5 GB storage, 1 GB/month egress, 100K requests/month.
# Bucket must remain private; never enable public access.