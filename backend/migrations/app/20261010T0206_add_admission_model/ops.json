        "description": "create table \"Admission\"",
        "sql": "CREATE TABLE \"public\".\"Admission\" (\n  \"admittedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dischargedAt\" timestamptz,\n  \"facilityId\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"notes\" text,\n  \"patientId\" text NOT NULL,\n  \"staffId\" text NOT NULL,\n  \"status\" text DEFAULT 'ADMITTED' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"ward\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"Admission_status_check_bfff8205\" CHECK (\"status\" IN ('ADMITTED', 'DISCHARGED', 'TRANSFERRED')),\n  CONSTRAINT \"Admission_ward_check_11a48c15\" CHECK (\"ward\" IN ('GENERAL', 'ICU', 'PEDIATRIC', 'MATERNITY', 'EMERGENCY', 'SURGICAL', 'ISOLATION', 'OTHER'))\n)",
